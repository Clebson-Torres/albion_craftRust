{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Albion Crafting Overlay",
  "version": "0.1.0",
  "identifier": "com.clebs.albioncraftingoverlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Albion Crafting Overlay",
        "width": 980,
        "height": 760,
        "resizable": true,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    },
    "icon": []
  }
}
