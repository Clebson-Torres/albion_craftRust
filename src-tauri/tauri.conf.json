{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Albion Crafting Overlay",
  "version": "0.1.1",
  "identifier": "com.clebs.albioncraftingoverlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Albion Crafting Overlay",
        "width": 540,
        "height": 900,
        "minWidth": 500,
        "minHeight": 760,
        "x": 18,
        "y": 24,
        "resizable": true,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
